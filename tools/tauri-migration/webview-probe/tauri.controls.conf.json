{
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "controls-diagnostic",
          "description": "Disposable window-controls diagnostic: the page may drive its own window and read its state; no storage, no filesystem, no shell.",
          "local": true,
          "webviews": ["probe"],
          "permissions": [
            "allow-controls-report",
            "allow-controls-allow-close",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-minimize",
            "core:window:allow-unminimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "core:window:allow-set-fullscreen",
            "core:window:allow-is-maximized",
            "core:window:allow-is-minimized",
            "core:window:allow-is-decorated",
            "core:window:allow-is-resizable",
            "core:window:allow-is-fullscreen",
            "core:window:allow-inner-size",
            "core:window:allow-outer-position",
            "core:window:allow-scale-factor"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  }
}
